<?xml version='1.0' encoding='utf-8'?>
<!-- Paketkennung: nach der ersten Veröffentlichung unveränderlich.
     Vor dem Anlegen in den Store-Konsolen bewusst festlegen.
     Aufbau wie bei MatheSnack und Drawmory. -->
<widget id="de.sneakplay.app"
        version="1.0.0"
        android-versionCode="10000"
        ios-CFBundleVersion="10000"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>SneakPlay</name>
    <description>Das Partyspiel für ein Handy – für Spieleabende und den Unterricht: Bluffen, geheime Missionen, Begriffe erklären und die tickende Wort-Bombe. Handy reihum weiterreichen und loslegen – offline, ohne Konto, ohne Werbung, ohne Tracking. Deutsch und Englisch.</description>
    <author email="smaehlmann.appdev@gmail.com">Wisdompeak Apps – Simon Mählmann</author>

    <content src="index.html" />

    <!-- Kein <access origin="*">: Die App lädt keine fremden Inhalte.
         Externe Links (Store-Seite, E-Mail) gehen an das System. -->
    <allow-intent href="mailto:*" />
    <allow-intent href="https://*/*" />
    <!-- „Bewerten“ in den Einstellungen: jede Fassung öffnet nur ihren eigenen Store -->
    <allow-intent href="itms-apps:*" />
    <allow-intent href="market:*" />

    <preference name="DisallowOverscroll" value="true" />
    <preference name="Fullscreen" value="false" />
    <!-- Pass & Play: Das Handy wandert von Hand zu Hand – hochkant. -->
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="0xff17122f" />
    <!-- QR-Scanner: Kamerabild im WebView statt Vollbild-Player -->
    <preference name="AllowInlineMediaPlayback" value="true" />
    <preference name="MediaTypesRequiringUserActionForPlayback" value="none" />

    <platform name="ios">
        <preference name="deployment-target" value="15.0" />
        <!-- Nur Handy: Für iPad wären eigene Bildschirmfotos und alle
             Ausrichtungen Pflicht. Auf Tablets läuft die Handy-Fassung trotzdem. -->
        <preference name="target-device" value="handset" />
        <preference name="AllowBackForwardNavigationGestures" value="false" />
        <preference name="StatusBarOverlaysWebView" value="true" />
        <preference name="StatusBarStyle" value="lightcontent" />

        <edit-config target="ITSAppUsesNonExemptEncryption" file="*-Info.plist" mode="overwrite">
            <false/>
        </edit-config>
        <!-- Das Teilen-Plugin trägt diese Schlüssel mit leerem Text ein; leere
             Zweckangaben lehnt die Prüfung ab. SneakPlay teilt nur einen Text
             mit Link, die Mediathek wird nie gelesen. -->
        <!-- Pflicht: Ohne Zweckangabe beendet iOS die App beim ersten Kamerazugriff. -->
        <edit-config target="NSCameraUsageDescription" file="*-Info.plist" mode="overwrite">
            <string>SneakPlay nutzt die Kamera nur, um QR-Codes mit Kartensets anderer Geräte zu lesen. Bilder werden weder gespeichert noch gesendet. / SneakPlay uses the camera only to read QR codes with card sets from other devices. Images are never stored or sent.</string>
        </edit-config>
        <edit-config target="NSPhotoLibraryAddUsageDescription" file="*-Info.plist" mode="overwrite">
            <string>SneakPlay speichert nichts in deiner Fotomediathek. Diese Angabe ist nur für das Teilen-Menü des Systems nötig. / SneakPlay never saves to your photo library. This entry is only needed for the system share menu.</string>
        </edit-config>
        <edit-config target="NSPhotoLibraryUsageDescription" file="*-Info.plist" mode="overwrite">
            <string>SneakPlay liest keine Fotos. Diese Angabe ist nur für das Teilen-Menü des Systems nötig. / SneakPlay never reads your photos. This entry is only needed for the system share menu.</string>
        </edit-config>

        <icon src="res/ios/icon-20.png"   width="20"   height="20" />
        <icon src="res/ios/icon-29.png"   width="29"   height="29" />
        <icon src="res/ios/icon-40.png"   width="40"   height="40" />
        <icon src="res/ios/icon-58.png"   width="58"   height="58" />
        <icon src="res/ios/icon-60.png"   width="60"   height="60" />
        <icon src="res/ios/icon-76.png"   width="76"   height="76" />
        <icon src="res/ios/icon-80.png"   width="80"   height="80" />
        <icon src="res/ios/icon-87.png"   width="87"   height="87" />
        <icon src="res/ios/icon-120.png"  width="120"  height="120" />
        <icon src="res/ios/icon-152.png"  width="152"  height="152" />
        <icon src="res/ios/icon-167.png"  width="167"  height="167" />
        <icon src="res/ios/icon-180.png"  width="180"  height="180" />
        <icon src="res/ios/icon-1024.png" width="1024" height="1024" />
        <splash src="res/ios/Default@2x~universal~anyany.png" />
    </platform>

    <platform name="android">
        <preference name="android-minSdkVersion"     value="24" />
        <preference name="android-targetSdkVersion"  value="36" />
        <preference name="android-compileSdkVersion" value="36" />
        <preference name="AndroidXEnabled" value="true" />
        <preference name="AndroidWindowSplashScreenBackground" value="#17122F" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/android/icon_fg_xxxhdpi.png" />

        <!-- Kurzes Vibrieren beim Aufdecken und bei der Wort-Bombe.
             Normale Berechtigung ohne Abfrage; ohne sie ignoriert der
             WebView navigator.vibrate(). -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.VIBRATE" />
            <!-- QR-Scanner für Kartensets; Geräte ohne Kamera bleiben installierbar -->
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-feature android:name="android.hardware.camera" android:required="false" />
        </config-file>

        <resource-file src="res/android/colors.xml" target="/app/src/main/res/values/sneakplay_colors.xml" />

        <icon density="ldpi"    background="@color/sneakplay_icon_background" foreground="res/android/icon_fg_ldpi.png"    src="res/android/icon_ldpi.png" />
        <icon density="mdpi"    background="@color/sneakplay_icon_background" foreground="res/android/icon_fg_mdpi.png"    src="res/android/icon_mdpi.png" />
        <icon density="hdpi"    background="@color/sneakplay_icon_background" foreground="res/android/icon_fg_hdpi.png"    src="res/android/icon_hdpi.png" />
        <icon density="xhdpi"   background="@color/sneakplay_icon_background" foreground="res/android/icon_fg_xhdpi.png"   src="res/android/icon_xhdpi.png" />
        <icon density="xxhdpi"  background="@color/sneakplay_icon_background" foreground="res/android/icon_fg_xxhdpi.png"  src="res/android/icon_xxhdpi.png" />
        <icon density="xxxhdpi" background="@color/sneakplay_icon_background" foreground="res/android/icon_fg_xxxhdpi.png" src="res/android/icon_xxxhdpi.png" />
    </platform>

    <plugin name="cordova-plugin-statusbar" spec="^4.0.0" />
    <!-- „Weiterempfehlen“: Teilen-Menü des Systems mit Text und Link -->
    <plugin name="cordova-plugin-x-socialsharing" spec="^6.0.4" />
    <!-- Bildschirm bleibt während einer Runde an (Timer, Wort-Bombe) -->
    <plugin name="cordova-plugin-insomnia" spec="^4.3.0" />
    <!-- Kamera-Erlaubnis unter Android zur Laufzeit abfragen (QR-Scanner) -->
    <plugin name="cordova-plugin-android-permissions" spec="^1.1.5" />
</widget>
